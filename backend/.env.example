# ORVEX Backend Environment Configuration

APP_NAME="ORVEX API"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL="INFO"

# Database Credentials & Connection URLs
DATABASE_URL="postgresql+asyncpg://orvex_user:orvex_dev_secret@localhost:5432/orvex_db"
SYNC_DATABASE_URL="postgresql+psycopg2://orvex_user:orvex_dev_secret@localhost:5432/orvex_db"

# LLM Gateway Configuration
# Supported providers: mock | openai | claude | openai-compatible
LLM_PROVIDER=mock
# Configured model for active provider (e.g. gpt-4o-mini for openai, claude-3-7-sonnet-20250219 for claude)
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Generic / Fallback API Key and Base URL (optional)
LLM_API_KEY=
LLM_API_BASE_URL=

# Provider-Specific Credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
