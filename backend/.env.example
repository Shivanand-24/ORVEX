# ORVEX Backend Environment Configuration

APP_NAME="ORVEX API"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL="INFO"

# Database Credentials & Connection URLs
DATABASE_URL="postgresql+asyncpg://orvex_user:orvex_dev_secret@localhost:5432/orvex_db"
SYNC_DATABASE_URL="postgresql+psycopg2://orvex_user:orvex_dev_secret@localhost:5432/orvex_db"

# LLM Gateway Configuration
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
